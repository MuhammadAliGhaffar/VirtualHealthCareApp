<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.RegistrationFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgRegistration"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_registration" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/imgRegistration"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/edtUsername"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:fontFamily="@font/roboto_regular"
                android:hint="Username" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_below="@id/edtUsername"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:fontFamily="@font/roboto_regular"
                android:hint="Email" />


            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_below="@id/edtEmail"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:fontFamily="@font/roboto_regular"
                android:hint="Password"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/edtRePassword"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_below="@id/edtPassword"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:fontFamily="@font/roboto_regular"
                android:hint="Re-Password"
                android:inputType="textPassword" />


            <TextView
                android:id="@+id/txtTermsAndCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/edtRePassword"
                android:layout_alignStart="@id/edtRePassword"
                android:layout_alignEnd="@id/edtRePassword"
                android:layout_marginStart="40dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/roboto_bold"
                android:text="By signing up you accept the Term of service and Privacy Policy" />

            <Button
                android:id="@+id/btnSignUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtTermsAndCondition"
                android:layout_marginHorizontal="20dp"
                android:backgroundTint="#00a89a"
                android:fontFamily="@font/roboto_bold"
                android:text="Sign Up" />

            <TextView
                android:id="@+id/txtSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btnSignUp"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Already have an account? Sign in" />
        </RelativeLayout>

    </RelativeLayout>

</FrameLayout>