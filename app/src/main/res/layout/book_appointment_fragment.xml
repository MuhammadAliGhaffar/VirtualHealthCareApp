<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.BookAppointmentFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/purple_700">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:fontFamily="@font/roboto_regular"
                android:text="Book Appointment"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </androidx.appcompat.widget.Toolbar>


        <RelativeLayout
            android:id="@+id/suggestDoctorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolBar"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_black_boundary"
            android:paddingBottom="10dp">

            <RelativeLayout
                android:id="@+id/innerSuggestDoctorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_corners"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/suggestDoctorImageView"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/female_doctor" />

                <TextView
                    android:id="@+id/doctorTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/suggestDoctorImageView"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@id/suggestDoctorImageView"
                    android:text="Doctor"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/doctorNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/doctorTextView"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@id/suggestDoctorImageView"
                    android:text="Dr Anum"
                    android:textColor="@color/white"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/doctorHospitalTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/doctorNameTextView"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@id/suggestDoctorImageView"
                    android:text="Abbasi Shaheed Hospital"
                    android:textColor="@color/white"
                    android:textStyle="normal" />

                <ImageView
                    android:id="@+id/patientImageView"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_below="@id/suggestDoctorImageView"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/male_doctor" />

                <TextView
                    android:id="@+id/patientTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/patientImageView"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@id/patientImageView"
                    android:text="Patient"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/patientNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/patientTextView"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@id/patientImageView"
                    android:text="Muhammad Ali Ghaffar"
                    android:textColor="@color/white"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/patientGenderTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/patientNameTextView"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@id/patientImageView"
                    android:text="Male"
                    android:textColor="@color/white"
                    android:textStyle="normal" />


            </RelativeLayout>


            <TextView
                android:id="@+id/appointmentTimeTextview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Time :"
                android:textSize="17sp"
                android:textColor="#000"
                android:layout_below="@+id/innerSuggestDoctorContainer"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtAppointmentTime"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/appointmentTimeTextview"
                android:background="@drawable/edit_text_border"
                android:fontFamily="@font/roboto_regular"
                android:hint="Enter Time" />

            <TextView
                android:id="@+id/appointmentDateTextview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Date :"
                android:textSize="17sp"
                android:textColor="#000"
                android:layout_below="@+id/edtAppointmentTime"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtAppointmentDate"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/appointmentDateTextview"
                android:background="@drawable/edit_text_border"
                android:fontFamily="@font/roboto_regular"
                android:hint="Enter Date" />

            <Button
                android:id="@+id/suggestDoctorButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_below="@+id/edtAppointmentDate"
                android:layout_marginTop="30dp"
                android:backgroundTint="@color/purple_700"
                android:text="Book Appointment" />


        </RelativeLayout>

    </RelativeLayout>
</FrameLayout>